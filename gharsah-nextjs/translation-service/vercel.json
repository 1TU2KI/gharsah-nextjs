{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run download-model",
  "outputDirectory": "public",
  "regions": ["iad1"],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": ".model-cache/**"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/index" },
    { "source": "/translate", "destination": "/api/index" }
  ]
}
